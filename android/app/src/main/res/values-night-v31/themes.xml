<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Yellow brand; light/dark follow the phone. -->
    <style name="Theme.EmoJet" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:colorAccent">@color/sun</item>
        <!-- Android 12+ system splash: the page colour, no icon; hands over to the artwork splash. -->
        <item name="android:windowSplashScreenBackground">@color/page</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
